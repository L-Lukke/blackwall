.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
.env
.env.*
!.env.example

bin/
*.test
coverage.out

target/
**/target/

tmp/
temp/
*.tmp
dist/
out/

# Runtime data generated by local scenarios.
scenarios/.logs/
testdata/audit/*.ndjson
testdata/credentials/*.json
testdata/data/*.ndjson

# Keep fixture directories and seed files tracked.
!testdata/credentials/.gitkeep
!testdata/data/.gitkeep
!testdata/policies/
!testdata/policies/*.json
!testdata/revocations/
!testdata/revocations/*.json

configs/dev/local.override.yaml
configs/dev/*.local.yaml
